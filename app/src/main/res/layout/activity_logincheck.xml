<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg">


    <EditText
        android:id="@+id/username_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignEnd="@+id/buttoncheck"
        android:layout_alignRight="@+id/buttoncheck"
        android:layout_marginEnd="30dp"
        android:layout_marginRight="30dp"
        android:layout_marginTop="55dp"
        android:ems="10"
        android:inputType="textPersonName"
        android:text="username "
        tools:layout_editor_absoluteX="167dp"
        tools:layout_editor_absoluteY="42dp" />

    <EditText
        android:id="@+id/pass_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/username_text"
        android:layout_alignStart="@+id/username_text"
        android:layout_below="@+id/username_text"
        android:layout_marginTop="20dp"
        android:ems="10"
        android:inputType="textPassword"
        tools:layout_editor_absoluteX="170dp"
        tools:layout_editor_absoluteY="93dp" />

    <EditText
        android:id="@+id/repass_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/pass_text"
        android:layout_alignStart="@+id/pass_text"
        android:layout_below="@+id/pass_text"
        android:layout_marginTop="30dp"
        android:ems="10"
        android:inputType="textPassword"
        tools:layout_editor_absoluteX="167dp"
        tools:layout_editor_absoluteY="156dp" />

    <Button
        android:id="@+id/buttoncheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/repass_text"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="59dp"
        android:text="Signup"
        tools:layout_editor_absoluteX="297dp"
        tools:layout_editor_absoluteY="234dp" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/pass_text"
        android:layout_marginEnd="46dp"
        android:layout_marginRight="46dp"
        android:layout_toLeftOf="@+id/username_text"
        android:layout_toStartOf="@+id/username_text"
        android:text="Studentname" />

    <TextView
        android:id="@+id/textView10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/repass_text"
        android:layout_alignLeft="@+id/textView9"
        android:layout_alignStart="@+id/textView9"
        android:text="Password" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/repass_text"
        android:layout_alignLeft="@+id/textView10"
        android:layout_alignStart="@+id/textView10"
        android:text="Verify password" />


</RelativeLayout>
