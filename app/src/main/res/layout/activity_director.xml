        <!--android:id="@+id/deleteStudent"-->
        <!--android:layout_width="wrap_content"-->
        <!--android:layout_height="wrap_content"-->
        <!--android:layout_alignLeft="@+id/edittutorbtn"-->
        <!--android:layout_alignStart="@+id/edittutorbtn"-->
        <!--android:layout_below="@+id/edittutorbtn"-->
        <!--android:text="Delete Student/tutor" />-->

</RelativeLayout>
</ScrollView>