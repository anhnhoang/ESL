<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.esl.edittutor">


    <ListView
        android:id="@+id/tutorlistlistview"
        android:layout_width="368dp"
        android:layout_height="317dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        tools:layout_editor_absoluteX="8dp"
        tools:layout_editor_absoluteY="8dp" />

    <EditText
        android:id="@+id/edittutorid_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignEnd="@+id/tutoreditbutton"
        android:layout_alignRight="@+id/tutoreditbutton"
        android:layout_centerVertical="true"
        android:ems="10"
        android:inputType="textPersonName"
        android:text="Enter Tutor Name"
        tools:layout_editor_absoluteX="153dp"
        tools:layout_editor_absoluteY="325dp" />

    <Button
        android:id="@+id/tutoreditbutton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignEnd="@+id/tutorlistlistview"
        android:layout_alignRight="@+id/tutorlistlistview"
        android:layout_below="@+id/edittutorid_text"
        android:layout_marginEnd="50dp"
        android:layout_marginRight="50dp"
        android:text="Find"
        tools:layout_editor_absoluteX="280dp"
        tools:layout_editor_absoluteY="385dp" />



</RelativeLayout>

